<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <TextView
        android:id="@+id/topic"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="60dp"
        android:layout_marginBottom="30dp"
        android:text="Gym calendar"
        android:textSize="28sp"
        app:layout_constraintBottom_toTopOf="@+id/btnGoRegister"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <Button
        android:id="@+id/btnGoRegister"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="35dp"
        android:layout_marginBottom="21dp"
        android:text="Register"
        app:layout_constraintBottom_toTopOf="@+id/btnGoLogin"
        app:layout_constraintStart_toStartOf="@+id/topic"
        app:layout_constraintTop_toBottomOf="@+id/topic" />

    <Button
        android:id="@+id/btnGoLogin"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="21dp"
        android:text="Login"
        app:layout_constraintBottom_toTopOf="@+id/btnGoOther"
        app:layout_constraintStart_toStartOf="@+id/btnGoRegister"
        app:layout_constraintTop_toBottomOf="@+id/btnGoRegister" />

    <Button
        android:id="@+id/btnGoOther"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Other"
        app:layout_constraintBottom_toTopOf="@+id/Logo_App"
        app:layout_constraintStart_toStartOf="@+id/btnGoLogin"
        app:layout_constraintTop_toBottomOf="@+id/btnGoLogin" />

    <ImageView
        android:id="@+id/Logo_App"
        android:layout_width="190dp"
        android:layout_height="0dp"
        android:layout_marginBottom="38dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/btnGoOther"
        app:srcCompat="@drawable/gym_calender_logo" />

</androidx.constraintlayout.widget.ConstraintLayout>
