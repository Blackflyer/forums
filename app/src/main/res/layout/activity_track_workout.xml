<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:gravity="center"
    android:background="#F5F5F5">

    <TextView
        android:id="@+id/tvExerciseNameTrack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="שם התרגיל"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="32dp"/>

    <EditText
        android:id="@+id/etActualWeight"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="משקל (קג)"
        android:inputType="numberDecimal"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="16dp"/>

    <EditText
        android:id="@+id/etActualReps"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:hint="מספר חזרות שבוצעו"
        android:inputType="number"
        android:background="#FFFFFF"
        android:padding="12dp"
        android:layout_marginBottom="32dp"/>

    <Button
        android:id="@+id/btnSaveProgress"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="שמור ביצוע!"
        android:textSize="18sp"
        android:backgroundTint="#4CAF50"
        android:textColor="#FFFFFF"/>

</LinearLayout>