<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAchievementIcon"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:background="#F5F5F5"
            android:gravity="center"
            android:text="🏆"
            android:textSize="32sp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvAchievementName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שם ההישג"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primaryTextColor" />

            <TextView
                android:id="@+id/tvAchievementDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="תיאור איך להשיג את ההישג"
                android:textSize="14sp"
                android:textColor="@color/secondaryTextColor" />
        </LinearLayout>

        <ImageView
            android:id="@+id/ivLockStatus"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:src="@android:drawable/ic_partial_secure"
            app:tint="#BDBDBD" />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>