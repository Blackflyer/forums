<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    style="@style/AppCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="16dp"
    android:layout_marginVertical="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <ImageView
            android:id="@+id/ivPlanIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:src="@drawable/gym_calender_logo"
            android:padding="4dp"
            android:background="@color/backgroundColor"
            android:contentDescription="Plan Icon" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="16dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPlanName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="שם התוכנית"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/primaryTextColor" />

            <TextView
                android:id="@+id/tvPlanDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="תאריך: 06/04/2026"
                android:textSize="14sp"
                android:textColor="@color/secondaryTextColor"
                android:layout_marginTop="4dp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="end">

            <TextView
                android:id="@+id/tvExerciseCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="5 תרגילים"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="@color/primaryColor"
                android:background="@drawable/ic_launcher_background"
                android:backgroundTint="@color/backgroundColor"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEditPlan"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="ערוך"
                android:textColor="@color/primaryColor"
                android:textSize="12sp"
                app:icon="@android:drawable/ic_menu_edit"
                app:iconSize="16dp" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>